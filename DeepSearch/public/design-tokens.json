    "product": "DeepSearch",
    "spec": "DeepSearch-D-02b",
    "namespace": "ds2",
    "extends": "DeepSearch-D-02",
    "date": "2026-11-05",
    "note": "Three-layer handoff. Additive polish over D-02. Forbidden: purple AI gradient, glass soup, neon lime, lp.*"
