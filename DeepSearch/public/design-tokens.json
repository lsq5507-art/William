        "aiPurple": { "$value": "#7C3AED", "$type": "color", "$comment": "NEVER use as brand" },
        "nearBlackPage": { "$value": "#0A0A0A", "$type": "color", "$comment": "OK as ink only, NEVER as page bg" }
      }
