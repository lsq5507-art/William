      "paper": { "50": { "$value": "#FAFAF9", "$type": "color" }, "100": { "$value": "#F5F5F4", "$type": "color" }, "200": { "$value": "#E7E5E4", "$type": "color" }, "300": { "$value": "#D6D3D1", "$type": "color" } },
      "stone": { "400": { "$value": "#A8A29E", "$type": "color" }, "500": { "$value": "#78716C", "$type": "color" }, "600": { "$value": "#57534E", "$type": "color" }, "950": { "$value": "#0A0A0A", "$type": "color" } },
      "navy": { "50": { "$value": "#EEF2F6", "$type": "color" }, "700": { "$value": "#0A2540", "$type": "color" }, "800": { "$value": "#06182B", "$type": "color" }, "900": { "$value": "#040F1A", "$type": "color" } },
